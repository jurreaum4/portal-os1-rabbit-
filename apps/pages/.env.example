# Local development uses the Vite /api proxy to http://127.0.0.1:8787.
# Production Pages build: set the live Worker URL here.
VITE_API_URL=https://portal-os1.<your-worker-subdomain>.workers.dev
# Example: VITE_API_URL=https://portal-os1.<your-account>.workers.dev
# Production Pages URL: https://portal-os1-rabbit-dn1.pages.dev
